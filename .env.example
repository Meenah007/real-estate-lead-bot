# ============================================================
# Real Estate Lead Bot - Local Development Environment
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit the real .env file.
# ============================================================

# Application
APP_ENV=development
APP_NAME=real-estate-lead-bot
APP_VERSION=0.1.0
DEBUG=true

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------
# Database - Local MySQL (recommended for development)
# ------------------------------------------------------------
# Replace the password with your actual MySQL root (or user) password.
# Make sure the database "real_estate_leads" already exists.
DATABASE_URL=mysql+aiomysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/real_estate_leads
DATABASE_URL_SYNC=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/real_estate_leads

# Optional (only used by docker-compose if you ever need it later)
MYSQL_ROOT_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DATABASE=real_estate_leads

# JWT / Auth
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# n8n (local instance)
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/primehomes/lead/process-message
N8N_WEBHOOK_SECRET=change-me-n8n-webhook-secret
N8N_BASE_URL=http://localhost:5678
N8N_CONTEXT_MESSAGE_LIMIT=12

# AI Provider (example – use whatever you prefer)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# Google Sheets (optional operational sync)
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Logging
LOG_LEVEL=INFO
